{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "trela",
  "version": "1.0.0",
  "identifier": "com.king.trela",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "trela",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/mpv"],
    "resources": {
      "binaries/d3dcompiler_43.dll": "d3dcompiler_43.dll",
      "../scripts/setup-anime.ps1": "setup-anime.ps1"
    }
  }
}
